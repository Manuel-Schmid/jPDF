{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JuliePDF",
  "version": "1.2.0",
  "identifier": "app.juliepdf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JuliePDF",
        "decorations": false,
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "center": true,
        "visible": false,
        "backgroundColor": "#0F111A",
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "JuliePDF",
    "copyright": "© 2026 JuliePDF",
    "shortDescription": "Lightweight PDF annotator",
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF Document",
        "description": "PDF Document",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2NkY5OERBNTgzNUIzRUYKUldUdnN6VlkycGh2VnJxN2M3TmdQdS8vZ2J4K0gybXFBSmtqVTF1U0V3L1d2ZUI4SUNyUlRmK2wK",
      "endpoints": [
        "https://github.com/Manuel-Schmid/jPDF/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
